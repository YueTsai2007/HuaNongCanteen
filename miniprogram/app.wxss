/* ================= 设计令牌（与 Android 端一致） =================
   Leaf     #31845D  主色
   LeafDark #176342  深绿（价格/强调）
   Canvas   #F6F8F5  页面底色
   Ink      #202720  正文
   Muted    #7C867E  辅助文字
   Line     #E8ECE7  分隔线
   ChipSel  #E8F3EC  选中胶囊底
   SideBg   #F0F3EF  侧栏底
   StatBg   #F3F7F3  统计小格底
   ToggleBg #E9EEE9  分段切换底
   渐变占位  #E4EEE7 → #F8EBDD
   Danger   #B64035
================================================================= */

page {
  background: #F6F8F5;
  color: #202720;
  font-size: 28rpx;
  line-height: 1.55;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.grow {
  flex: 1;
  min-width: 0;
}

.muted {
  color: #7C867E;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #E8ECE7;
}

/* 卡片：白底大圆角 */
.card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 28rpx;
}

/* 文字按钮（对应 Compose TextButton） */
.link {
  color: #31845D;
  font-size: 26rpx;
  padding: 8rpx 12rpx;
}

.link.muted-link {
  color: #7C867E;
  font-size: 24rpx;
}

.link.danger-link {
  color: #B64035;
}

/* 按钮 */
.btn {
  border-radius: 30rpx;
  font-size: 30rpx;
  padding: 22rpx 36rpx;
  line-height: 1.4;
  text-align: center;
  border: none;
  font-weight: 500;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #31845D;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #a7cdbb;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #31845D;
  border: 2rpx solid #E8ECE7;
}

.btn-danger-ghost {
  background: #ffffff;
  color: #B64035;
  border: 2rpx solid #E8ECE7;
}

.btn-block {
  display: block;
  width: 100%;
}

.btn-sm {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
}

/* 输入 */
.input {
  background: #ffffff;
  border: 2rpx solid #E8ECE7;
  border-radius: 28rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.textarea {
  background: #ffffff;
  border: 2rpx solid #E8ECE7;
  border-radius: 28rpx;
  padding: 20rpx 26rpx;
  font-size: 26rpx;
  width: auto;
  margin-bottom: 20rpx;
  min-height: 120rpx;
}

.field-label {
  font-size: 24rpx;
  color: #202720;
  font-weight: 500;
  margin: 8rpx 0 12rpx;
}

/* 图片占位：渐变 + emoji */
.menu-img {
  background: linear-gradient(135deg, #E4EEE7 0%, #F8EBDD 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb {
  width: 148rpx;
  height: 148rpx;
  border-radius: 28rpx;
}

/* 数量步进器：圆形 − / 绿色圆形 ＋ */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #E8ECE7;
  color: #7C867E;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  box-sizing: border-box;
}

.stepper-btn.plus {
  background: #31845D;
  border: none;
  color: #ffffff;
}

.stepper-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #202720;
}

/* 胶囊筛选（对应 Compose FilterChip） */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #7C867E;
  background: transparent;
  margin-right: 16rpx;
}

.chip.on {
  background: #E8F3EC;
  color: #176342;
  font-weight: 600;
}

/* 状态小标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #E8F3EC;
  color: #176342;
}

.tag.warn {
  background: #faeeda;
  color: #854f0b;
}

.tag.error {
  background: #fcebeb;
  color: #a32d2d;
}

/* 空状态卡片 */
.empty-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 44rpx 44rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-emoji {
  font-size: 70rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202720;
  margin-top: 18rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #7C867E;
  margin-top: 10rpx;
  text-align: center;
}

.empty-btn {
  margin-top: 24rpx;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 48rpx;
}

.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #202720;
  margin-bottom: 20rpx;
}

/* 提示条 */
.banner {
  border-radius: 24rpx;
  padding: 20rpx 26rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}

.banner.error {
  background: #fcebeb;
  color: #a32d2d;
}

.banner.info {
  background: #E8F3EC;
  color: #176342;
}
