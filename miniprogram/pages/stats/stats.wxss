page {
  height: 100%;
}

.stats-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

/* 头部栏 */
.header {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #E8ECE7;
}

.logo-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #E8F3EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.h-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #202720;
  margin-left: 22rpx;
}

.h-sub {
  font-size: 22rpx;
  color: #7C867E;
  margin-left: 22rpx;
  margin-top: 4rpx;
}

/* 月份卡 */
.month-card {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  flex-shrink: 0;
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-arrow {
  font-size: 48rpx;
  color: #31845D;
  padding: 0 40rpx;
  line-height: 1;
}

.month-arrow.off {
  color: #C9D1CA;
}

.month-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #202720;
}

.summary {
  display: flex;
  margin-top: 24rpx;
  background: #F3F7F3;
  border-radius: 20rpx;
  padding: 20rpx 0;
}

.sum-cell {
  flex: 1;
  text-align: center;
}

.sum-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #176342;
}

.sum-label {
  font-size: 22rpx;
  color: #7C867E;
  margin-top: 6rpx;
}

/* 列表 */
.list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}

.day-group {
  margin-top: 24rpx;
}

.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.day-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #202720;
}

.day-cost {
  font-size: 22rpx;
}

.log-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.log-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #202720;
}

.log-place {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.log-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.log-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #176342;
}

.log-del {
  font-size: 22rpx;
  color: #B64035;
  margin-top: 10rpx;
}

/* 星级 */
.star-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.star {
  font-size: 34rpx;
  color: #DDE4DE;
  margin-right: 8rpx;
}

.star.on {
  color: #F5A623;
}

.star-hint {
  font-size: 20rpx;
  margin-left: 8rpx;
}

.empty-card {
  margin-top: 60rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202720;
  margin-top: 20rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #7C867E;
  margin-top: 12rpx;
}

.tail-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.muted {
  color: #7C867E;
  font-weight: 400;
}
