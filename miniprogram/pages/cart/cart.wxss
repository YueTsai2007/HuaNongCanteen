page {
  height: 100%;
}

.list-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

/* 头部栏 */
.header {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 28rpx;
}

.logo-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #E8F3EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.h-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #202720;
}

.h-sub {
  font-size: 22rpx;
  color: #7C867E;
  margin-top: 2rpx;
}

/* 分组列表 */
.list {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.shop-group {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #202720;
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.line-name {
  font-size: 28rpx;
  color: #202720;
}

.line-price {
  font-size: 24rpx;
  color: #176342;
  margin-top: 6rpx;
}

/* 已吃打勾 */
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #B9C3BB;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.check.on {
  background: #31845D;
  border-color: #31845D;
}

.line.done .line-name {
  color: #7C867E;
  text-decoration: line-through;
}

.line.done .line-price {
  color: #7C867E;
}

/* 底部状态栏 */
.footer-bar {
  background: #ffffff;
  padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
}

.footer-text {
  font-size: 28rpx;
  color: #202720;
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx 120rpx;
}

.empty-wrap .empty-card {
  width: 100%;
}

.tail-space {
  height: 32rpx;
}
