.page {
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #E8F3EC;
  color: #176342;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.email {
  font-size: 32rpx;
  font-weight: 600;
  color: #202720;
  word-break: break-all;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #202720;
  margin-bottom: 16rpx;
}

.about .row {
  margin-bottom: 8rpx;
}

.gap {
  width: 20rpx;
}

.gap-v {
  height: 20rpx;
}
