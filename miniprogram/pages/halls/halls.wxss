page {
  height: 100%;
}

.home {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

/* 头部栏 */
.header {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 28rpx;
}

.logo-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #E8F3EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.h-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #202720;
}

.h-sub {
  font-size: 22rpx;
  color: #7C867E;
  margin-top: 2rpx;
}

.header .link {
  margin-left: 8rpx;
}

/* 问候语 */
.greet {
  padding: 20rpx 36rpx 8rpx;
}

.greet-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #202720;
}

.greet-sub {
  font-size: 26rpx;
  color: #7C867E;
  margin-top: 8rpx;
}

/* 左侧食堂栏 + 右侧列表 */
.body {
  flex: 1;
  min-height: 0;
  display: flex;
  padding-top: 16rpx;
}

.side {
  width: 196rpx;
  flex-shrink: 0;
  background: #F0F3EF;
  height: 100%;
  box-sizing: border-box;
  padding: 12rpx 0;
}

.side-item {
  display: flex;
  align-items: center;
  margin: 6rpx 16rpx;
  padding: 26rpx 16rpx;
  border-radius: 26rpx;
  min-height: 60rpx;
  box-sizing: border-box;
}

.side-item.on {
  background: #ffffff;
}

.side-bar {
  width: 6rpx;
  height: 36rpx;
  border-radius: 6rpx;
  background: #31845D;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.side-name {
  font-size: 24rpx;
  color: #7C867E;
  line-height: 1.35;
}

.side-item.on .side-name {
  color: #176342;
  font-weight: 600;
}

.main {
  flex: 1;
  min-width: 0;
  height: 100%;
  box-sizing: border-box;
  padding: 14rpx 30rpx 0 24rpx;
}

.main-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.hall-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #202720;
}

/* 店铺卡片 */
.shop-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.shop-emoji {
  font-size: 60rpx;
}

.info {
  margin: 0 20rpx 0 22rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #202720;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.shop-name .floor-badge {
  white-space: nowrap;
}

.shop-desc {
  font-size: 22rpx;
  color: #7C867E;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.shop-meta {
  font-size: 22rpx;
  color: #31845D;
  margin-top: 16rpx;
}

.del {
  flex-shrink: 0;
}

.tail-space {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.gap {
  width: 20rpx;
}

.danger-btn {
  background: #ffffff;
  color: #B64035;
  border: 2rpx solid #E8ECE7;
}

/* 楼层筛选 */
.floor-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 4rpx 4rpx 20rpx;
}

.floor-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #E8ECE7;
  font-size: 24rpx;
  color: #202720;
}

.floor-chip.on {
  background: #E8F3EC;
  border-color: #31845D;
  color: #176342;
  font-weight: 600;
}

.floor-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #176342;
  background: #E8F3EC;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}
