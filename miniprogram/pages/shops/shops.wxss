.page {
  padding: 24rpx;
}

.main-head {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 20rpx;
}

.hall-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #202720;
}

.shop-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.shop-emoji {
  font-size: 60rpx;
}

.info {
  margin: 0 20rpx 0 22rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #202720;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-desc {
  font-size: 22rpx;
  color: #7C867E;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.shop-meta {
  font-size: 22rpx;
  color: #31845D;
  margin-top: 16rpx;
}

.gap {
  width: 20rpx;
}
